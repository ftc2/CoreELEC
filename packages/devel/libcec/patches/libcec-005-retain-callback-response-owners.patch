 CCECClient::~CCECClient(void)
 {
-  StopThread();
-  CCallbackWrap* cb;
+  StopCallbacks();
+  std::shared_ptr<CCallbackWrap> cb;
   while (!m_callbackCalls.IsEmpty())
     if (m_callbackCalls.Pop(cb, 0))
-      delete cb;
+      cb.reset();
 
   // unregister the client
   if (m_processor && IsRegistered())
     m_processor->UnregisterClient(this);
+}
+
+bool CCECClient::StartCallbacks(void)
+{
+  if (IsRunning())
+    return true;
+
+  // Discard events from the closed connection before admitting a new one.
+  std::shared_ptr<CCallbackWrap> cb;
+  while (!m_callbackCalls.IsEmpty())
+    if (m_callbackCalls.Pop(cb, 0))
+      cb.reset();
+  return CreateThread();
+}
+
+void CCECClient::StopCallbacks(void)
+{
+  StopThread(0);
+}
+
+void CCECClient::DetachProcessor(void)
+{
+  CLockObject lock(m_mutex);
+  m_processor = NULL;
 }
 
